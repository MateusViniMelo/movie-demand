# Banco local (Docker Compose). Copie este arquivo para .env.
DATABASE_URL=postgresql://catalogo:catalogo@localhost:5432/catalogo

# Na Vercel, defina DATABASE_URL em Settings → Environment Variables,
# para Production e Preview, disponível em Build e Runtime.
# Cada deploy roda `prisma migrate deploy` e depois `prisma db seed`.
# O seed apaga e regrava o catálogo de data/tmdb.
# Use um Postgres hospedado. Preview deve ter o próprio banco,
# para um deploy de pull request não regravar o de produção.
# DATABASE_URL=postgresql://usuario:senha@host:5432/catalogo?sslmode=require

READ_TOKEN_MOVIE-DB=
API_KEY_MOVIE-DB=

# Origem pública (canônica, Open Graph, sitemap).
# Sem uma URL absoluta http ou https, o fallback é http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://exemplo.com
